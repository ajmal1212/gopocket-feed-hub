# Upstream Noren feed. One live session per account: whoever connects last wins,
# so this account must be dedicated to the hub and used by nothing else. A
# developer running the hub locally against the production account will
# disconnect production. Use a separate account per environment.
NOREN_WS_URL=wss://skypro.skybroking.com/NorenWSWeb/
NOREN_UID=

# The session key. Rotates daily. Either set it here, or point KEY_FILE at a
# file that whatever mints the key writes to - the hub re-reads that file on
# every (re)connect, so refreshing the key needs no restart.
FEED_JKEY=
# KEY_FILE=/var/lib/feed-hub/jkey

# Browser-facing server.
PORT=8090
HOST=127.0.0.1
ALLOWED_ORIGINS=https://gopocket.in,https://www.gopocket.in,http://localhost:4321

# Abuse limits.
MAX_CONNECTIONS_PER_IP=8
MAX_TOKENS_PER_CLIENT=120

# Drop the upstream connection when nobody has been watching for this long.
# Overnight the hub costs nothing and holds no session.
IDLE_DISCONNECT_MS=300000
