# Upstream Noren feed. One live session per account: whoever connects last
# wins, so this account must be dedicated to the hub and used by nothing else.
NOREN_WS_URL=wss://skypro.skybroking.com/NorenWSWeb/
NOREN_REST_URL=https://skypro.skybroking.com

# Where the session key comes from. Frappe regenerates it every morning around
# 08:15 under the "Website live price" doctype, along with the account id, so
# the hub reads both on every connect rather than holding one from boot. This
# API token is long-lived - it is the one credential that does not rotate.
FRAPPE_URL=https://pulse.gopocket.in
FRAPPE_TOKEN=

# Local development only: set both to bypass Frappe and use a key you hold.
# FEED_JKEY=
# NOREN_UID=

# Daily connection window, IST. Opens before the equity session and runs late
# because MCX trades into the night. Outside it the hub holds no session at all.
CONNECT_AT=09:00
DISCONNECT_AT=23:45

# Subscribed for the hub's own sake, so the feed always has something flowing
# and the connection is demonstrably alive rather than merely open.
ALWAYS_SUBSCRIBE=NSE|26000

# Browser-facing server.
PORT=8090
HOST=127.0.0.1
ALLOWED_ORIGINS=https://gopocket.in,https://www.gopocket.in,http://localhost:4321

# Monitoring dashboard at / and /dashboard. Leave empty for open access on a
# private network; set it to require ?key=<value> the moment the hub is
# reachable by anyone else - the dashboard shows what the feed is carrying.
DASHBOARD_TOKEN=

# Abuse limits.
MAX_CONNECTIONS_PER_IP=8
MAX_TOKENS_PER_CLIENT=120
